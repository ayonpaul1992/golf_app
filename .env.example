# Copy to .env and obtain environment-specific values from the team.
ENV=dev
DEV_BASE_URL=https://your-staging-api.example/api/v1
PROD_BASE_URL=https://your-production-api.example/api/v1
DEV_SOCKET_URL=https://your-staging-api.example
PROD_SOCKET_URL=https://your-production-api.example
DEV_GOLF_COURSE_CODE=
PROD_GOLF_COURSE_CODE=
SENTRY_DSN=
SENTRY_SEND_DEFAULT_PII=false
SENTRY_ENABLE_LOGS=false
SENTRY_TRACES_SAMPLE_RATE=0.1

# Compatibility defaults for currently deployed APIs. Obtain existing keys from
# the owner; these values are recoverable in legacy app builds, not authorization.
API_PAYLOAD_FORMAT=legacy
API_ENCRYPTION_KEY=
WEATHER_SOURCE=direct
OPEN_WEATHER_API_KEY=
# Enable only when the backend logout endpoint has been deployed and verified.
SESSION_REVOCATION_ENABLED=false
